# Server Port
PORT=5000

# MongoDB Connection String (e.g. MongoDB Atlas or local MongoDB)
MONGO_URI=mongodb://localhost:27017/mentormap

# JSON Web Token Secret (used for signing auth tokens)
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini API Key (Get from https://aistudio.google.com/app/apikey)
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini API Endpoint
GOOGLE_GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent
